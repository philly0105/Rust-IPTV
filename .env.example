# Tsrust IPTV local configuration. Copy to `.env` and fill in what you need.
# The TMDB module reads `.env` from the app data folder first, then from the
# current working directory. It never reads the process environment, and the
# key is never logged. A key saved in Settings > Metadata takes precedence.

# TMDB API key (v3 key or v4 read access token) for plots, cast, trailers and rails.
# TMDB_API_KEY=

# Optional: override the TMDB API base URL (tests and proxies only).
# TMDB_BASE_URL=https://api.themoviedb.org/3
