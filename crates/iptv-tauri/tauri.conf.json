{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tsrust IPTV",
  "version": "0.2.0",
  "identifier": "com.philly.tsrustiptv",
  "build": {
    "frontendDist": "../../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Tsrust IPTV",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "dragDropEnabled": false,
        "visible": false,
        "backgroundColor": "#0c1320",
        "additionalBrowserArgs": "--disable-features=msSmartScreenProtection,msWebOOUI,msPdfOOUI,msEdgeCollections,CalculateNativeWinOcclusion --renderer-process-limit=1 --disable-extensions --no-pre-read-main-dll --disable-background-networking"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: asset: http://asset.localhost https: http:",
        "media-src": "'self' blob: data: asset: http://asset.localhost https: http:",
        "connect-src": "'self' ipc: http://ipc.localhost asset: http://asset.localhost https: http: ws: wss:",
        "font-src": "'self' data:",
        "worker-src": "'self' blob:",
        "frame-src": "https://www.youtube-nocookie.com https://www.youtube.com"
      },
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/downloads/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "philly",
    "copyright": "Copyright © 2026 philly. MIT License.",
    "homepage": "https://github.com/philly0105/Rust-IPTV",
    "category": "Video",
    "shortDescription": "IPTV player for M3U playlists, Xtream accounts and Stalker portals",
    "longDescription": "Tsrust IPTV plays your own M3U playlists, Xtream Codes accounts and Stalker portals. It has live TV with a searchable TV guide, catch-up, movies and series with a My List, custom channel lists, a four-channel multi-view, downloads for offline viewing, series recording rules, parental controls and a phone remote. No channels or other content come with the app.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "iptv"
        ]
      }
    },
    "updater": {
      "endpoints": [
        "https://example.invalid/tsrust-iptv/latest.json"
      ],
      "pubkey": ""
    }
  }
}
