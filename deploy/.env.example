# Copy to .env in this folder and fill it in. See README.md here.

# The name or address people type in the browser, without https:// or a port.
# Examples: tv.example.com, nas.lan, 192.168.1.20
TSRUST_HOST=

# "internal" for a LAN name or IP address (Caddy's own certificates), or your
# e-mail address for a Let's Encrypt certificate on a public domain.
TSRUST_TLS=internal

# Login for the password prompt. Make the hash with:
#   docker run --rm -it caddy:2 caddy hash-password
# Keep the single quotes: the hash contains $ signs.
TSRUST_USER=tv
TSRUST_PASSWORD_HASH=''

# Image tag to run, for example 0.2.0. Default: latest.
# TSRUST_VERSION=latest
